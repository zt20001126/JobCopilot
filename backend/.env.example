# 应用运行环境和日志级别
APP_ENV=development
LOG_LEVEL=INFO

# MVP 默认使用 SQLite；正式环境可替换为 PostgreSQL 连接串。
DATABASE_URL=sqlite:///./jobcopilot.db

# 默认启用 mock，接入 DeepSeek 后再关闭。
ENABLE_MOCK_AI=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REQUEST_TIMEOUT_SECONDS=10

# 隐私配置：默认不在数据库保存完整岗位描述。
STORE_JOB_DESCRIPTION=false

# 多个来源使用英文逗号分隔；插件来源可通过正则单独控制。
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ORIGIN_REGEX=^chrome-extension://.*$
