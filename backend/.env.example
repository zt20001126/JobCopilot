# 应用运行环境和日志级别
APP_ENV=development
LOG_LEVEL=INFO

# MVP 默认使用 SQLite；正式环境可替换为 PostgreSQL 连接串。
DATABASE_URL=sqlite:///./jobcopilot.db

# 本地首次启动可使用 mock；配置真实密钥后改为 false。
ENABLE_MOCK_AI=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
REQUEST_TIMEOUT_SECONDS=10

# MVP 单实例限流和输入保护。
MAX_JOB_DESCRIPTION_LENGTH=20000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# 隐私配置：默认不在数据库保存完整岗位描述。
STORE_JOB_DESCRIPTION=false

# 多个来源使用英文逗号分隔；插件来源可通过正则单独控制。
CORS_ORIGINS=http://localhost,http://127.0.0.1
CORS_ORIGIN_REGEX=^chrome-extension://.*$
