{
  "manifest_version": 3,
  "name": "JobCopilot - AI 求职副驾驶",
  "description": "读取岗位信息并生成针对性的求职招呼语。",
  "version": "0.1.0",
  "action": {
    "default_title": "JobCopilot",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
